{
  "name": "elite-journal-hub",
  "version": "1.0.0",
  "description": "A local-first personal-growth desktop app for journaling, prayer tracking, relationship-keeping, and habit-building, with a unified calendar that pulls from every tab.",
  "keywords": [
    "journal",
    "prayer",
    "habits",
    "calendar",
    "electron",
    "react",
    "firebase",
    "personal-growth"
  ],
  "main": "electron/main.js",
  "author": "Elite Journal Hub",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:client\" \"npm run dev:electron\"",
    "dev:client": "cd client && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build:client": "cd client && npm run build",
    "build": "npm run build:client && electron-builder",
    "dist:mac": "npm run build:client && electron-builder --mac",
    "dist:win": "npm run build:client && electron-builder --win",
    "dist:linux": "npm run build:client && electron-builder --linux",
    "release:mac": "npm run build:client && electron-builder --mac --publish always",
    "release:win": "npm run build:client && electron-builder --win --publish always",
    "release:linux": "npm run build:client && electron-builder --linux --publish always"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.elitejournalhub.app",
    "productName": "Elite Journal Hub",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "!**/node_modules/.cache",
      "!**/*.map"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "REPLACE_WITH_YOUR_GITHUB_USERNAME",
        "repo": "REPLACE_WITH_YOUR_REPO_NAME",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSCameraUseContinuityCameraDeviceType": true,
        "NSCameraUsageDescription": "Ministry Hub uses the camera to record podcast videos through the in-app Recording Studio.",
        "NSMicrophoneUsageDescription": "Ministry Hub uses the microphone to record podcast audio and instrument takes through the in-app Recording Studio.",
        "NSAppleMusicUsageDescription": "Ministry Hub uses audio devices to capture podcast and music recordings."
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "firebase": "^12.13.0"
  }
}
