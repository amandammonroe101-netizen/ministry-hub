# Firebase web app config — copy this file to client/.env and fill in the
# values from your Firebase project (Project settings → General → Your apps →
# SDK setup and configuration → npm).
#
# These are PUBLIC keys, safe to commit if you want — security is enforced
# by Firestore Security Rules + Firebase Auth, NOT by hiding the API key.
# https://firebase.google.com/docs/projects/api-keys

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
