/* ─────────────────────────────────────────────────────────────
   Firestore security rules for Ministry Hub.

   Paste this into Firebase Console:
     Firestore Database  →  Rules  →  Publish

   Layers:
   - /users/{uid}                  → public profile (anyone signed in can read,
                                     only owner can write)
   - /users/{uid}/kv/{key}         → private per-user data store
                                     (only owner reads/writes)
   - /userKeys/{identifyingKey}    → key → uid lookup index for Chat
                                     (anyone signed in can read, only the
                                     matching user can create/delete)
   - /channels/{channelId}         → chat channels (public + private)
   - /channels/{channelId}/messages/{messageId}  → chat messages
   ───────────────────────────────────────────────────────────── */

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── User profile (the parent /users/{uid} doc) ──────────
       Anyone signed in can READ profiles. This is what powers the
       identifying-key lookup feature and chat author labels.
       Only the owner can write. */
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid;
    }

    /* ── Private per-user key/value store ────────────────────
       Only the owner can read or write. This is where useUserStoreKey
       persists app data (blog posts, songs, journal entries, etc.). */
    match /users/{uid}/kv/{key} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    /* ── Per-user studio projects (one doc per project) ────────
       Replaces the legacy single-array /users/{uid}/kv/studio-projects
       so each project gets its own 1 MiB Firestore budget instead of
       fighting for room in one shared doc. */
    match /users/{uid}/studio-projects/{projectId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    /* ── Per-user writing documents (one doc per document) ─────
       Replaces the legacy single-array /users/{uid}/kv/writing:documents
       so each Writing Mode document gets its own 1 MiB Firestore budget
       instead of fighting for room in one shared blob. */
    match /users/{uid}/writingDocs/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    /* ── Identifying-key index ────────────────────────────────
       Maps a human-shareable key like "ABCD-EFGH" to a uid so other
       users can add you to private chats without knowing your uid. */
    match /userKeys/{key} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      // No update — keys are immutable once claimed.
    }

    /* ── Chat channels ──────────────────────────────────────── */
    match /channels/{channelId} {
      // Joining a PUBLIC channel — add my own uid only, size grew by 1.
      // Banned users (those the owner has explicitly removed) are
      // blocked from rejoining via the bannedUids check.
      function isSelfJoinPublic() {
        return resource.data.type == 'public'
          && !(request.auth.uid in resource.data.get('bannedUids', []))
          && !(request.auth.uid in resource.data.memberUids)
          && (request.auth.uid in request.resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['memberUids', 'updatedAt']);
      }

      // Leaving a PUBLIC channel.
      function isSelfLeavePublic() {
        return resource.data.type == 'public'
          && (request.auth.uid in resource.data.memberUids)
          && !(request.auth.uid in request.resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['memberUids', 'updatedAt']);
      }

      // Accepting an invite to a PRIVATE channel — same size/membership
      // check, PLUS we require an /invites/{channelId}_{uid} doc to exist
      // (this is what the owner created when they sent the invitation).
      function isSelfAcceptInvitePrivate() {
        return resource.data.type == 'private'
          && !(request.auth.uid in resource.data.memberUids)
          && (request.auth.uid in request.resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['memberUids', 'updatedAt'])
          && exists(/databases/$(database)/documents/invites/$(channelId + '_' + request.auth.uid));
      }

      // Leaving a PRIVATE channel.
      function isSelfLeavePrivate() {
        return resource.data.type == 'private'
          && (request.auth.uid in resource.data.memberUids)
          && !(request.auth.uid in request.resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['memberUids', 'updatedAt']);
      }

      // Read: public channels visible to all; private only to members
      allow read: if request.auth != null && (
        resource.data.type == 'public'
        || request.auth.uid in resource.data.memberUids
      );

      // Create: any signed-in user; must set themselves as owner +
      //         the first member of memberUids
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.type in ['public', 'private']
                    && request.auth.uid in request.resource.data.memberUids;

      // Update: owner can edit any field, OR a non-owner can toggle
      //         their own membership (join/leave) under the right
      //         conditions (public can self-join freely; private requires
      //         an outstanding invitation).
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid
        || isSelfJoinPublic()
        || isSelfLeavePublic()
        || isSelfAcceptInvitePrivate()
        || isSelfLeavePrivate()
      );

      // Delete: only the owner
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;

      /* ── Messages inside a channel ───────────────────────
         For public channels: any signed-in user can read/post,
         EXCEPT users on the channel's bannedUids list.
         For private channels: members only (membership itself is
         already gated by invite + isSelfAcceptInvitePrivate). */
      match /messages/{messageId} {
        function channelDoc() {
          return get(/databases/$(database)/documents/channels/$(channelId)).data;
        }
        function isAllowedReader() {
          let ch = channelDoc();
          return (
            ch.type == 'public'
            && !(request.auth.uid in ch.get('bannedUids', []))
          ) || (
            request.auth.uid in ch.memberUids
          );
        }

        // Read
        allow read: if request.auth != null && isAllowedReader();

        // Create — author must be current user, and they must be
        // allowed to participate in the channel
        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid
          && isAllowedReader();

        // Update/Delete: the author of the message, OR the channel
        // owner (so owners can moderate content in their channels).
        allow update, delete: if request.auth != null && (
          resource.data.authorUid == request.auth.uid
          || channelDoc().ownerUid == request.auth.uid
        );
      }
    }

    /* ── Studio project "send a copy" inbox ──────────────────
       Used by the Studio's "share + send a copy" feature. The
       sender writes a project snapshot here; the recipient sees a
       chat card with an Import button that copies the snapshot
       into their own /users/{uid}/kv/studio-projects list and then
       deletes the snapshot. Both sender and recipient can read
       (sender to see what they shared, recipient to import).
       Recipient can delete (after import or to dismiss). */
    match /studioShares/{shareId} {
      allow read: if request.auth != null && (
        resource.data.senderUid    == request.auth.uid
        || resource.data.recipientUid == request.auth.uid
      );
      allow create: if request.auth != null
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid != request.auth.uid;
      allow delete: if request.auth != null && (
        resource.data.senderUid    == request.auth.uid
        || resource.data.recipientUid == request.auth.uid
      );
      // No updates — snapshots are immutable.
    }

    /* ── Recording-session schedule requests ─────────────────
       When a user schedules a session with a collaborator, the
       SchedulingRec page writes a request here so the recipient
       can later see it in their inbox. Both sender and recipient
       can read + delete; only the sender can create (and only on
       their own behalf). No updates — accept/decline is modeled
       as a `status` field that future inbox UI will set, but for
       now the rule keeps it create+delete-only to lock things
       down. Add an update rule once the inbox UI exists. */
    match /scheduleRequests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.senderUid    == request.auth.uid
        || resource.data.recipientUid == request.auth.uid
      );
      allow create: if request.auth != null
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid != request.auth.uid;
      allow delete: if request.auth != null && (
        resource.data.senderUid    == request.auth.uid
        || resource.data.recipientUid == request.auth.uid
      );
    }

    /* ── Studio collaborative projects ───────────────────────
       Used by the Studio's "collaborate live" feature. The
       project doc lives here and any listed editor can read AND
       write (so changes from one collaborator stream to the
       other via onSnapshot). The original owner can also delete.

       READ is allowed if the user is in EITHER editorUids OR
       acceptedUids. Why both? The Studio sidebar's subscription
       filters with `where('acceptedUids', 'array-contains', uid)`
       to hide invitations the user hasn't accepted yet, but
       Firestore's rules engine can't statically prove that
       acceptedUids ⊆ editorUids — so it denies the query unless
       the rule allows reads through the same field the query
       filters on. Adding `acceptedUids` to the read rule fixes
       that without weakening security (in practice acceptedUids
       is always a subset of editorUids, since acceptInvite only
       runs when the caller is already in editorUids). */
    match /sharedStudioProjects/{projectId} {
      allow read: if request.auth != null && (
           request.auth.uid in resource.data.editorUids
        || request.auth.uid in resource.data.get('acceptedUids', [])
      );
      allow update: if request.auth != null
        && request.auth.uid in resource.data.editorUids;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.editorUids;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    /* ── Private-channel invitations ─────────────────────────
       Document ID convention: `${channelId}_${inviteeUid}` — predictable
       so the channel update rule can call exists() on it.

       SIMPLIFIED RULES (no cross-doc get()):
       Previous versions tried to verify, inside the rule, that the
       inviter actually owned the target channel by calling
       `get(/channels/<channelId>).data.ownerUid == auth.uid`. That
       cross-document read kept failing with "Missing or insufficient
       permissions" in production, with no clear way to diagnose from
       the client side.

       This version drops that check. Security is preserved because:

       1. CREATE only allows writing if invitedByUid == auth.uid — you
          can only invite ON YOUR OWN BEHALF. You cannot impersonate
          another user as the sender.
       2. The ACCEPT path (channel update with isSelfAcceptInvitePrivate)
          still requires an /invites/{channelId}_{uid} doc to exist
          before a non-owner can add themselves to memberUids. So the
          invite is the "permission slip" — without it, you can't join.
       3. Channel content (messages, member lists) is still protected by
          the channel rules — you have to be in memberUids to read.

       The remaining trade-off: a malicious user COULD spam-create
       invitations to channels they don't own. The invitee just sees
       an unwanted invite card and clicks Decline. Worst case is UX
       noise, not data leakage. The CLIENT code in chatInvites.js
       already enforces "only the owner can invite" before attempting
       the write, so honest clients can never trigger spam invites. */
    match /invites/{inviteId} {

      // Read: invitee or the sender can see it
      allow read: if request.auth != null && (
        resource.data.inviteeUid    == request.auth.uid
        || resource.data.invitedByUid == request.auth.uid
      );

      // Create: you can only send invites AS YOURSELF, and you can't
      // invite yourself (which would let you bypass channel membership
      // restrictions). No cross-document checks — see header comment.
      allow create: if request.auth != null
        && request.resource.data.invitedByUid == request.auth.uid
        && request.resource.data.inviteeUid != request.auth.uid;

      // Delete: invitee (decline / accept-cleanup) OR sender (cancel)
      allow delete: if request.auth != null && (
        resource.data.inviteeUid    == request.auth.uid
        || resource.data.invitedByUid == request.auth.uid
      );

      // No updates — invites are accept-or-decline, no editing
    }
  }
}
